<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>false</PublishTrimmed>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202608" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202608" />
    <PackageReference Include="EpicManifestParser" Version="3.0.0-preview.1" />

    <!--
      Pin the patched 9.x transitive dependency without moving the launch-safe
      CUE4Parse backend off 202608. Versions through 9.0.13 are affected by
      GHSA-73j8-2gch-69rq.
    -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.14" />

    <!--
      CUE4Parse-Conversion uses SkiaSharp for texture encoding.
      The managed SkiaSharp package is pulled transitively, but Linux needs the
      native runtime asset as well. Back4App/Docker is Linux, so keep this
      explicit to make TextureService PNG encoding work reliably.
    -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
  </ItemGroup>
</Project>
